---

import MainGridLayout from '../layouts/MainGridLayout.astro'

import { getEntry } from 'astro:content'
import { i18n } from '../i18n/translation'
import I18nKey from '../i18n/i18nKey'
import Markdown from '@components/misc/Markdown.astro'
import Comments from '@components/Comments.astro'
import Friend from '@components/misc/Friend.astro'

const friendsPost = await getEntry('spec', 'friends')

const { Content } = await friendsPost.render()
---
<MainGridLayout title={i18n(I18nKey.friends)} description={i18n(I18nKey.friends)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <Markdown class="mt-2">
                <Content />
            </Markdown>

            <Friend 
                name="ARKKUMA's Blog" 
                url="https://blog.arkkuma.top/" 
                description="好耶，是熊熊🐻"
                icon="fa6-solid:blog" 
                avatar="https://blog.arkkuma.top/_astro/arkkuma-avatar.ByYWwraL_Z2ucRbL.webp" 
            />
            
            <br/><Friend 
                name="Clansty's Blog" 
                url="https://nyac.at/" 
                description="0w0w0w0w0w0w0w0w0w0w0w"
                icon="fa6-solid:blog" 
                avatar="https://nyac.at/x_assets_x/x_CKSwUizPfr__x.webp" 
            />
        </div>
    </div>

    <br/>

    <Comments></Comments>
</MainGridLayout>